{
  "name": "termix-plugin-host-auth-badges",
  "private": true,
  "version": "1.1.0",
  "description": "Termix plugin that shows compact authentication source and method badges in the host list.",
  "keywords": [
    "termix",
    "termix-plugin",
    "ssh",
    "rdp",
    "host-list",
    "badges"
  ],
  "homepage": "https://github.com/Reydan46/termix-plugin-host-auth-badges#readme",
  "bugs": {
    "url": "https://github.com/Reydan46/termix-plugin-host-auth-badges/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reydan46/termix-plugin-host-auth-badges.git"
  },
  "license": "MIT",
  "author": "Reydan46",
  "type": "module",
  "scripts": {
    "build": "termix-plugin build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc -p .",
    "validate": "npm run build && termix-plugin validate",
    "pack": "npm run validate && termix-plugin pack",
    "test:sdk": "termix-plugin test"
  },
  "devDependencies": {
    "@termix-ssh/plugin-sdk": "^2.10.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
