    "@types/react": "^19.2.18",
    "i18next": "^26.7.2",
    "jsdom": "^29.1.1",
    "react-i18next": "^17.1.13",
    "sonner": "^2.0.8",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@termix-ssh/plugin-sdk": "^2.10.1",
    "react": "^19.2.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
